# AI Video Cleaner — CPU sandbox (testes / validação de fluxo)
# Build: docker build -f Dockerfile.cpu -t cleaner-worker-cpu .
# Uso pretendido: VPS sem GPU, isolado, com limite de CPU/memória.

FROM python:3.10-slim-bookworm

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    CLEANER_STORAGE=/app/storage \
    CLEANER_DEVICE=cpu \
    OMP_NUM_THREADS=2 \
    MKL_NUM_THREADS=2

RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg libgl1 libglib2.0-0 libsm6 libxext6 libgomp1 curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements-cpu.txt .
RUN pip install --upgrade pip setuptools wheel && \
    pip install -r requirements-cpu.txt

COPY app/ ./app/
COPY scripts/ ./scripts/

RUN mkdir -p /app/storage /app/models && \
    useradd -m -u 10001 cleaner && chown -R cleaner:cleaner /app
USER cleaner

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=10s --start-period=90s --retries=3 \
    CMD curl -fsS http://localhost:8000/v1/health || exit 1

CMD ["python", "-m", "uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1"]
